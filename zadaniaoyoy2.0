function checkEmail($email) {
    if (strpos($email, "@") === false) {
        throw new Exception("Niepoprawny email.");
    }
}

try {
    checkEmail("gmail.com");
} catch (Exception $e) {
    echo $e->getMessage();
}


try {
    if (!file_exists("plik.txt")) {
        throw new Exception("Plik nie istnieje.");
    }

    fopen("plik.txt", "r");
} catch (Exception $e) {
    echo $e->getMessage();
}



try {
    echo "Kod w try";
} catch (Exception $e) {
    echo $e->getMessage();
} finally {
    echo " Koniec";
}



class MyException extends Exception {}

try {
    throw new MyException("Mój własny wyjątek.");
} catch (MyException $e) {
    echo $e->getMessage();
}
