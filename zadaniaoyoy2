<?php
try {
    $a = 10;
    $b = 0;

    if ($b == 0) {
        throw new Exception("Nie można dzielić przez zero.");
    }

    echo $a / $b;
} catch (Exception $e) {
    echo $e->getMessage();
}

<?php
function checkEmail($email) {
    if (strpos($email, "@") === false) {
        throw new Exception("Niepoprawny email.");
    }
}

try {
    checkEmail("test.pl");
} catch (Exception $e) {
    echo $e->getMessage();
}

